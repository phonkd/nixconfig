# Host-specific darwin config for Eliss-MacBook-Pro.
#
# flake.darwinConfigurations.<name> is generated by modules/builder.nix
# from lib/registry.nix. HM wiring (gui homeModule) is handled by the
# generic darwinModules.gui-darwin in modules/hosts/types/gui/default.nix.
{ ... }:
{
  flake.darwinModules.macm4 =
    {
      pkgs,
      config,
      lib,
      ...
    }:
    lib.mkIf (config.noughty.host.name == "Eliss-MacBook-Pro") {
      # Mac-specific HM extras layered on top of what gui-darwin imports.
      home-manager.users.phonkd.imports = [
        {
          targets.darwin = {
            copyApps.enable = false;
            linkApps.enable = true;
          };
          proxy.ipRanges = [
            "192.168.1.47/32"
            "192.168.1.201/32"
            "192.168.1.46/32"
            "192.168.1.200/32"
            "192.168.1.150/32"
            "192.168.1.203"
          ];
        }
      ];

      system.stateVersion = 6;
      nix.settings.experimental-features = "nix-command flakes";
      security.pam.services.sudo_local = {
        enable = true;
        touchIdAuth = true;
      };
      system.defaults = {
        NSGlobalDomain = {
          NSWindowShouldDragOnGesture = true;
          NSAutomaticQuoteSubstitutionEnabled = false;
        };
      };
      system.primaryUser = "phonkd";

      users.users.phonkd.home = "/Users/phonkd";
      homebrew = {
        enable = true;
        enableZshIntegration = true;
      };
    };
}
