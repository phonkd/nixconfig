+/**
+ * @brief Writes a captured image out as a PGM, for debugging.
+ *
+ * @details Off unless GOODIX52XD_DUMP is set to a path prefix, e.g.
+ * GOODIX52XD_DUMP=/tmp/goodix writes /tmp/goodix-0.pgm, -1.pgm, ... This is
+ * the only way to see what this sensor is actually handing to the minutiae
+ * extractor, rather than inferring it from match scores.
+ */
+static void dump_image_pgm(FpImage* img)
+{
+    static guint seq = 0;
+    const gchar* prefix = g_getenv("GOODIX52XD_DUMP");
+
+    if (prefix == NULL) {
+        return;
+    }
+
+    g_autofree gchar* path = g_strdup_printf("%s-%u.pgm", prefix, seq++);
+    g_autofree gchar* header =
+        g_strdup_printf("P5\n%u %u\n255\n", img->width, img->height);
+    g_autoptr(GError) error = NULL;
+    g_autofree gchar* blob = g_malloc(strlen(header) + img->width * img->height);
+    const gsize header_len = strlen(header);
+
+    memcpy(blob, header, header_len);
+    memcpy(blob + header_len, img->data, img->width * img->height);
+
+    if (!g_file_set_contents(path, blob, header_len + img->width * img->height,
+                             &error)) {
+        fp_warn("Failed to dump image to %s: %s", path, error->message);
+    }
+    else {
+        fp_dbg("Dumped capture to %s", path);
+    }
+}
